{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Product service tests",
			"type": "shell",
			"command": "mvn",
			"args": [
				"test"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Initialize products in user database",
			"type": "shell",
			"command": "C:\\xampp\\mysql\\bin\\mysql.exe",
			"args": [
				"-u",
				"root",
				"-e",
				"source database/product_service.sql"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Product Service web",
			"type": "shell",
			"command": "mvn",
			"args": [
				"spring-boot:run"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "product-service",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "Started ProductServiceApplication"
				}
			}
		},
		{
			"label": "Run Bth2 JWT on port 8082",
			"type": "shell",
			"command": "mvn",
			"args": [
				"-f",
				"..\\BaiTh2SOA\\pom.xml",
				"spring-boot:run"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "bth2",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "Started JwtRestApiApplication"
				}
			}
		},
		{
			"label": "Inspect shared user database",
			"type": "shell",
			"command": "C:\\xampp\\mysql\\bin\\mysql.exe",
			"args": [
				"-u",
				"root",
				"-N",
				"-e",
				"SELECT table_name FROM information_schema.tables WHERE table_schema='user' AND table_name IN ('products','user'); SELECT COUNT(*) FROM user.user; SELECT COUNT(*) FROM user.products;"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check tables in user database",
			"type": "shell",
			"command": "C:\\xampp\\mysql\\bin\\mysql.exe",
			"args": [
				"-u",
				"root",
				"-N",
				"-e",
				"SHOW TABLES FROM user;"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect user products schema",
			"type": "shell",
			"command": "C:\\xampp\\mysql\\bin\\mysql.exe",
			"args": [
				"-u",
				"root",
				"-N",
				"-e",
				"SELECT COUNT(*) FROM user.user; SELECT COUNT(*) FROM user.products; SHOW COLUMNS FROM user.products;"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check user database write",
			"type": "shell",
			"command": "C:\\xampp\\mysql\\bin\\mysql.exe",
			"args": [
				"-u",
				"root",
				"-N",
				"-e",
				"SELECT id, name, price, quantity FROM user.products WHERE id=8;"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check product database targets",
			"type": "shell",
			"command": "C:\\xampp\\mysql\\bin\\mysql.exe",
			"args": [
				"-u",
				"root",
				"-N",
				"-e",
				"SELECT id,name FROM user.products WHERE id=8; SELECT id,name FROM product_service.products WHERE id=8;"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify ID 8 in user database",
			"type": "shell",
			"command": "C:\\xampp\\mysql\\bin\\mysql.exe",
			"args": [
				"-u",
				"root",
				"-N",
				"-e",
				"SELECT id, name FROM user.products WHERE id=8;"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify ID 8 in product_service database",
			"type": "shell",
			"command": "C:\\xampp\\mysql\\bin\\mysql.exe",
			"args": [
				"-u",
				"root",
				"-N",
				"-e",
				"SELECT id, name FROM product_service.products WHERE id=8;"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stop old Product Service process",
			"type": "shell",
			"command": "Stop-Process",
			"args": [
				"-Id",
				"1152"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Remove old DB verification row",
			"type": "shell",
			"command": "C:\\xampp\\mysql\\bin\\mysql.exe",
			"args": [
				"-u",
				"root",
				"-e",
				"DELETE FROM product_service.products WHERE id=8;"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Confirm shared user DB seed count",
			"type": "shell",
			"command": "C:\\xampp\\mysql\\bin\\mysql.exe",
			"args": [
				"-u",
				"root",
				"-N",
				"-e",
				"SELECT COUNT(*) FROM user.user; SELECT COUNT(*) FROM user.products;"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect new user DB row",
			"type": "shell",
			"command": "C:\\xampp\\mysql\\bin\\mysql.exe",
			"args": [
				"-u",
				"root",
				"-N",
				"-e",
				"SELECT id, name, price, quantity FROM user.products WHERE id=6;"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}