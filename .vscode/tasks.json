{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Product service tests",
			"type": "shell",
			"command": "mvn",
			"args": [
				"test"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Initialize products in user database",
			"type": "shell",
			"command": "C:\\xampp\\mysql\\bin\\mysql.exe",
			"args": [
				"-u",
				"root",
				"-e",
				"source database/product_service.sql"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Product Service web",
			"type": "shell",
			"command": "mvn",
			"args": [
				"spring-boot:run"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "product-service",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "Started ProductServiceApplication"
				}
			}
		},
		{
			"label": "Inspect Bth2 process command line",
			"type": "shell",
			"command": "Get-CimInstance",
			"args": [
				"Win32_Process",
				"-Filter",
				"ProcessId = 1492",
				"|",
				"Select-Object",
				"ProcessId,CommandLine"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stop obsolete Bth2 service",
			"type": "shell",
			"command": "Stop-Process",
			"args": [
				"-Id",
				"1492"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}